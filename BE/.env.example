# --- OpenAI ---
OPENAI_API_KEY=sk-...
# Modelo con visión y function calling
OPENAI_VISION_MODEL=gpt-4o

# --- Base de datos MySQL (config/config.js) ---
DB_USER=root
DB_PASSWORD=
DB_NAME=database_development
DB_HOST=127.0.0.1
DB_PORT=3306
# true = sequelize.sync({ alter: true }): actualiza las tablas existentes al esquema v4.4.
# Úsalo al actualizar desde la versión anterior (renombra nif_rfc, numero_factura... sin perder datos)
# y vuelve a ponerlo en false después.
DB_SYNC_ALTER=false
# true = muestra las consultas SQL en consola
DB_LOGGING=false

# --- Agente ---
# Máximo de llamadas al modelo por ejecución (ciclo observar → decidir → actuar)
AGENTE_MAX_PASOS=8
# Por debajo de esta confianza (0-1) la regla de seguridad reintenta una vez en detail "high"
AGENTE_UMBRAL_CONFIANZA=0.7
# Cuántos recuerdos de la sesión se inyectan en el system prompt
AGENTE_MAX_RECUERDOS=10
# Máximo de ampliaciones (tool ampliar_zona, requiere sharp) por análisis
AGENTE_MAX_AMPLIACIONES=4
# Ancho mínimo (px) al que se amplía cada recorte
AGENTE_ZOOM_ANCHO_MIN=1500
# --- OCR (tool leer_digitos_ocr, requiere tesseract.js y sharp) ---
# Idioma de Tesseract: eng o spa (los datos se descargan una vez a .cache/tesseract)
OCR_IDIOMA=eng
# Tiempo máximo por lectura (ms)
OCR_TIMEOUT_MS=20000
# Ancho mínimo (px) del recorte que se pasa al OCR
OCR_ANCHO_MIN=2000
# Máximo de lecturas OCR por análisis
AGENTE_MAX_OCR=6
# Directorio de caché de los datos del idioma (opcional)
# OCR_CACHE_PATH=
# Con MySQL caído, cada cuánto (ms) la memoria vuelve a probar MySQL
MEMORIA_REINTENTO_MS=60000

# --- Servicio externo de proveedores (opcional) ---
# consultar_proveedor hace GET {URL}?identificacion=XXX con timeout (5 s).
# Ejemplo con el servicio público de Hacienda (actividad económica):
# PROVEEDORES_API_URL=https://api.hacienda.go.cr/fe/ae
PROVEEDORES_API_URL=
# Si se define, se envía como "Authorization: Bearer <clave>" (Hacienda no la necesita)
PROVEEDORES_API_KEY=

# --- Imagen corporativa de la factura ---
# Activa la llamada real a gpt-image-2 después de validar los datos estructurados.
OPENAI_IMAGE_MODEL=gpt-image-2
GENERADOR_GENERAR_IMAGEN=false
GENERADOR_MAX_INTENTOS=2

# --- Generación de facturas desde texto (POST /api/facturas/generar) ---
# Modelo de texto para extraer los datos del pedido (por defecto, OPENAI_VISION_MODEL)
# OPENAI_TEXT_MODEL=gpt-4o
# Los datos del emisor (FWD Costa Rica) están en config/emisor.json
